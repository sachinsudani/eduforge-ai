# Server
PORT=3001

# Auth — generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=eduforge

# Redis (job queue + cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI providers (RAG features are skipped if unset)
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=eduforge-subtitles

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Optional: seed an initial admin account on first boot (only if no admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
